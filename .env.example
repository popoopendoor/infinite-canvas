# Canvas public origin. Must match the HTTPS origin that serves Nginx in production.
APP_ORIGIN=http://localhost:3000

# Optional Docker-only URL for BFF requests to Flarum. Keep FLARUM_BASE_URL as the browser-visible URL.
FLARUM_INTERNAL_BASE_URL=http://host.docker.internal
# Flarum OAuth Center. FLARUM_BASE_URL is the Flarum root, BRIDGE_URL ends in /api.
FLARUM_BASE_URL=https://forum.example.com
# Must exactly match a client registered in Flarum OAuth Center.
OAUTH_CLIENT_ID=replace-with-the-registered-flarum-client-id
OAUTH_CLIENT_SECRET=replace-with-a-private-oauth-client-secret
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
# Shared limit for /auth/login and /auth/callback per client IP.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000
BRIDGE_URL=https://forum.example.com/api
BRIDGE_TOKEN=replace-with-a-private-bridge-token

# BFF model catalog source. Startup validates and snapshots its canonical form into
# SQLite as an immutable release; use a new priceVersion whenever a model's price changes.
# Prices are non-negative integer money units.
# An empty catalog is only suitable for UI/health-check work. To give users a
# usable configuration immediately after login, publish at least one model and
# map its ID below to a server-side provider key.
MODEL_CATALOG_JSON=[]
# Server-only JSON object mapping published model IDs to provider API keys.
# Map at least one published model for a production deployment. These models
# are managed by Canvas and do not require a browser API key.
MODEL_PROVIDER_KEYS_JSON={}
# Comma-separated provider host names. Required in production; private addresses are never allowed.
PROVIDER_BASE_URL_ALLOWLIST=api.openai.com,generativelanguage.googleapis.com
